{
    // 按 F5 启动调试。三个配置都会先执行 tasks.json 中的 "build task"，
    // 然后由 Cortex-Debug 直接下载 build/basic_framework.elf 并运行到 main。
    // 调试器程序路径建议配置在 VS Code 用户设置中，不在工程内写死。
    "version": "0.2.0",
    "configurations": [
        {
            "name": "DAPLink",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/basic_framework.elf",
            "request": "launch",
            "type": "cortex-debug",
            "device": "STM32F407IG",
            "svdFile": "${workspaceFolder}/STM32F407.svd",
            "servertype": "openocd",
            "configFiles": [
                "interface/cmsis-dap.cfg",
                "target/stm32f4x.cfg"
            ],
            "runToEntryPoint": "main",
            "rtos": "FreeRTOS",
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 4
            },
            "debuggerArgs": [
                "-iex",
                "set debug-file-directory ${workspaceFolder}/.gdb-debug"
            ],
            "preLaunchTask": "build task"
        },
        {
            "name": "ST-Link",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/basic_framework.elf",
            "request": "launch",
            "type": "cortex-debug",
            "device": "STM32F407IG",
            "svdFile": "${workspaceFolder}/STM32F407.svd",
            "servertype": "openocd",
            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32f4x.cfg"
            ],
            "runToEntryPoint": "main",
            "rtos": "FreeRTOS",
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 4
            },
            "debuggerArgs": [
                "-iex",
                "set debug-file-directory ${workspaceFolder}/.gdb-debug"
            ],
            "preLaunchTask": "build task"
        },
        {
            "name": "J-Link",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/basic_framework.elf",
            "request": "launch",
            "type": "cortex-debug",
            "device": "STM32F407IG",
            "svdFile": "${workspaceFolder}/STM32F407.svd",
            "servertype": "jlink",
            "interface": "swd",
            "runToEntryPoint": "main",
            "rtos": "FreeRTOS",
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 4
            },
            "debuggerArgs": [
                "-iex",
                "set debug-file-directory ${workspaceFolder}/.gdb-debug"
            ],
            "preLaunchTask": "build task"
        }
    ]
}
